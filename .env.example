# ─────────────────────────────────────────────────────────────
# Janelle Interiors AI Workflow System — environment template
# Copy to .env at the repo root and fill in. Never commit .env.
# The app runs in example mode with these left blank.
# ─────────────────────────────────────────────────────────────

# ── Supabase ────────────────────────────────────────────────
# From your Supabase project → Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection for migrations (npm run db:apply:seed):
# postgresql://postgres:[DB-PASSWORD]@db.YOUR-PROJECT.supabase.co:5432/postgres
SUPABASE_DB_URL=

# ── API server ──────────────────────────────────────────────
API_PORT=4055
API_HOST=localhost
CORS_ORIGINS=http://localhost:5173

# How long one reading pass may work before it answers with what it has.
# Must stay under the serverless function's maxDuration (60s in vercel.json)
# or the platform kills the request first and the caller sees a 504. Kept
# short so a browser is never waiting on a connection long enough for it to
# be dropped in transit — the dashboard just asks again until it is done.
# CRON_BUDGET_MS covers the scheduled runs, where nobody is waiting.
JOB_BUDGET_MS=20000
INGEST_BUDGET_MS=20000
CRON_BUDGET_MS=45000
# Jenny answers with what she has once this runs out, rather than being cut off.
ASSISTANT_BUDGET_MS=40000

# One call to Claude. The SDK defaults to ten minutes, which outlives the
# function it runs in — a hung call would take the whole request down.
ANTHROPIC_TIMEOUT_MS=25000
ANTHROPIC_MAX_RETRIES=1

# Extra sending domains to leave out of the reading pass, on top of the
# built-in list of tool notifications (Slack, GitHub, Dropbox and the like).
# Matched on the domain, not on "no-reply" — plenty of vendors send their
# order confirmations from no-reply@, and that mail must still be read.
INGEST_IGNORE_DOMAINS=

# ── Google OAuth (Gmail + Drive) ────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4055/api/auth/google/callback
# Least-privilege scopes: read mail, create drafts, read drive files
GOOGLE_SCOPES=https://www.googleapis.com/auth/gmail.readonly https://www.googleapis.com/auth/gmail.compose https://www.googleapis.com/auth/drive.readonly

# ── Claude API (intelligence layer) ─────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ── Gemini (presentation boards, and renderings) ────────────
# Must be a model that DRAWS. A text id here (gemini-flash-latest and the
# like) answers the brief in prose and never returns a picture, which reads
# like a refusal rather than a setting that needs changing.
#   gemini-3-pro-image      $0.18/image  — holds a supplied reference best
#   gemini-3.1-flash-image  $0.067/image — a third of the price, quicker
#   gemini-flash-lite-latest    free     — draws SVG, not photographs
# The first two need billing enabled on the Google Cloud project behind the
# key: image generation has no free tier, and reports a quota of 0 until it is.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# ── Grok / xAI (renderings and video) ───────────────────────
# From console.x.ai. Claude writes, Gemini draws the studio's boards, and
# this draws renderings and short clips. Leave blank and both tools refuse
# in words rather than failing oddly — that is the feature flag.
XAI_API_KEY=
XAI_IMAGE_MODEL=grok-imagine-image-2.0
XAI_VIDEO_MODEL=grok-imagine-video-1.5

# The studio's ceiling on one clip, under the provider's own 15s limit.
# Video is priced per second (8c on video-1.5), so this is the difference
# between a 50c clip and a $1.20 one, on something a spoken sentence starts.
MEDIA_MAX_SECONDS=8
# Counted from what has actually been billed today. Unlike every other
# guard, this one does not depend on the model behaving itself.
MEDIA_DAILY_USD_CAP=5
# A clip still pending after this is written off; nothing is charged.
MEDIA_GIVE_UP_MS=600000

# ── Token encryption (for stored Google tokens) ─────────────
# 32-byte base64 key. Generate: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# ── Web app (Vite) — only public values here ────────────────
# Supabase URL + anon key come from the server-side vars above;
# vite.config.ts injects them. Do not add VITE_ copies.
VITE_API_BASE_URL=http://localhost:4055
