{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/index.mjs": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path=/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/ops/cron/follow-ups",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/ops/cron/report",
      "schedule": "0 7 * * 1"
    },
    {
      "path": "/api/ops/cron/digest",
      "schedule": "5 7 * * *"
    }
  ]
}
